{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEED_INFO tool call",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_name", "arguments"],
  "properties": {
    "tool_name": { "const": "NEED_INFO" },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing"],
      "properties": {
        "missing": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["product", "category", "severity", "summary", "description", "os", "user_email"]
          }
        }
      }
    }
  }
}
